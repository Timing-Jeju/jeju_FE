# Public values only; do not place service_role, sb_secret_ or provider secrets here.
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local-only inputs for `npm run staging:e2e`; never expose the access token to Expo.
STAGING_API_BASE_URL=
STAGING_ACCESS_TOKEN=
